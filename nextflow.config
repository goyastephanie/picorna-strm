// NOTE: the includeConfig lines live AFTER the params block on purpose.
// conf/modules.config gates whole sections on `if (params.X)` and interpolates
// params into directives; if it is included first, every params.X reads as
// null there (silently dropping those sections).
params {

	help = false

	// General params                                                                   
	input = null                                                                
	output = 'revica_output'
	run_name = 'run'
	refs = "${projectDir}/assets/PICORNA_DB_v20280814_tag.fasta"
	skip_consensus = false
  sra_proper_pair = false
  use_mem2 = false
  del_nondb_bams = false

	// FASTP option                                                             
	adapter_trimming = "${projectDir}/assets/adapter.fasta"
	trim_len = 50
	save_trimmed_reads = false
	save_trimmed_fail = false
	save_merged = false
  min_trimmed_reads = 0

	// Kraken2 options
	run_kraken2 = false	
	kraken2_db = ''
	// Remove host-classified reads before reference detection and assembly.
	// (Upstream had two flags, kraken2_variants_host_filter and
	// kraken2_assembly_host_filter, but this pipeline has a single downstream
	// branch and only the first one ever filtered -- so they are merged here.)
	kraken2_host_filter = true
	save_kraken2_classified_reads = false
	save_kraken2_unclassified_reads = false

	// Seqtk sample options
	sample = 6000000
	save_sample_reads = false

	// Container override for fastp.
	// The default biocontainer is linux/amd64 only. On Apple Silicon it runs
	// under emulation, where fastp's SIMD gzip reader (isa-l) can fail on
	// valid files with "igzip: Error invalid gzip header".
	// Workarounds: enable Rosetta in Docker Desktop, or point this at a
	// multi-arch image that runs natively on arm64, e.g.
	//   --fastp_container 'community.wave.seqera.io/library/fastp:1.1.0--08aa7c5662a30d57'
	fastp_container = 'quay.io/biocontainers/fastp:0.23.2--h79da9fb_0'

	// Rhinovirus VP1 genotyping (optional module)
	// Types each final consensus against a nucleotide VP1 database.
	// Rebuild the VP1 db after curating the genome db with:
	//   bin/build_vp1_nt_db.py --picorna assets/PICORNA_DB_v20280814_tag.fasta \
	//                           --vp1_aa db/VP1_AA_164_annotated.fasta \
	//                           --out    db/VP1_NT_from_picorna.fasta
	rhinovirus = false
	vp1_db = "${projectDir}/db/VP1_NT_from_picorna.fasta"
	vp1_min_identity = 72        // min blastn % identity to consider a VP1 hit
	vp1_min_aln_len = 300        // min alignment length (nt) for a VP1 hit
	vp1_ambiguous_margin = 1.0   // flag call as ambiguous if 2nd-best genotype is within this % identity

	// ---- Sequencing mode -------------------------------------------------
	// Sets the library-specific processing. One of:
	//   amplicon    : trim the forward primer; NO duplicate removal
	//                 (amplicon reads share start coordinates by design)
	//   capture     : remove PCR duplicates; no primer trimming
	//   metagenomic : neither (few PCR cycles, no primers)
	mode = 'metagenomic'

	// Forward primer for --mode amplicon (IUPAC codes allowed).
	// The reverse primer anneals to the genomic poly(A) tail and therefore
	// needs no trimming.
	primer_fwd = 'TCCTCCGGYCCCTGAATGYGGCTAA'
	primer_max_mismatch = 4
	save_primertrim_bams = false

	// Manual overrides -- normally leave these alone and just set --mode.
	remove_duplicates = false
	trim_primers = false
	save_dedup_bams = false

	// ---- Per-position VCF (bcftools mpileup) -----------------------------
	// One VCF per consensus genome, written to <output>/vcf/. Every position is
	// reported with FORMAT/AD and FORMAT/DP, so intra-host (intra-genotype)
	// allele frequencies can be computed downstream at any site.
	call_variants = true
	vcf_max_depth = 1000000
	vcf_min_bq = 20
	vcf_min_mq = 20

	// ---- Optional called-variant table (iVar variants) -------------------
	// Adds a filtered variant table with allele frequencies, on top of the
	// per-position VCF above.
	ivar_variants = false
	ivar_var_q = 20      // min base quality
	ivar_var_t = 0.03    // min alternate allele frequency to report
	ivar_var_m = 10      // min depth to call a variant

	// Reference selection criteria
	ref_min_depth = 3
  ref_min_cov = 30

  // mpileup max depth for iVar steps
  // set this to zero to have unlimited depth
  mpileup_max_depth = 100

  // Thresholds for iVar on alignment to 1st consensus
  cons_init_min_depth = 5
  cons_init_min_cov = 60

  ivar_init_t = 0.6
  ivar_init_q = 20
  ivar_init_m = 1

  // Thresholds for iVar on alignment to 2nd consensus
  ivar_fin_t = 0.4
  ivar_fin_q = 20
  // 5 (not 10) so that low-abundance co-infecting genotypes are still
  // recoverable: at ~10x mean depth a threshold of 10 masks ~47% of the
  // genome as N, versus ~8% at 5. Raise it for single-infection runs where
  // per-base confidence matters more than completeness.
  ivar_fin_m = 5
		                                                                                   
	// Max resource option
	max_cpus = 32
	max_memory = '64.GB'
	max_time = '32.h'

}

// Included AFTER params so that conf/modules.config can read params.* (see note above)
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
	docker {
		docker.enabled = true
		// NOTE: must be 'docker.platform', not a bare 'platform' -- the latter
		// sets an unused top-level config key and is silently ignored, so
		// Docker never receives --platform (visible on Apple Silicon as
		// "no specific platform was requested").
		docker.platform = 'linux/amd64'
	}
}

def use_all_available_cores(obj) {
	
	def cur_max = Math.min(obj as int, Runtime.runtime.availableProcessors() as int)
	return Math.min(cur_max, params.max_cpus)
}

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
       try {
	    return Math.min( obj as int, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}
