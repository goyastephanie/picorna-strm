# Pipeline options that REQUIRE a value. Everything else passed with '--' is
# treated as a boolean flag (or an unknown param handed straight to Nextflow).
VALUE_OPTS = {
    "output", "run_name", "refs", "min_trimmed_reads",
    "adapter_fasta", "adapter_trimming", "trim_len",
    "kraken2_db", "sample",
    "ref_min_depth", "ref_min_cov", "mpileup_max_depth",
    "cons_init_min_depth", "cons_init_min_cov",
    "ivar_init_t", "ivar_init_q", "ivar_init_m",
    "ivar_fin_t", "ivar_fin_q", "ivar_fin_m",
    "vp1_db", "vp1_min_identity", "vp1_min_aln_len", "vp1_ambiguous_margin",
    "max_cpus", "max_memory", "max_time",
}


def normalize_params(extra):
    """
    Rewrite pipeline params into the explicit '--name=value' form.

    Nextflow parses '--name value' by joining the pair itself, and some
    versions refuse a bare '--name', failing with:
        Dynamic parameter expected a value of the form a=b but got:<name>
    Emitting '--name=value' (and '--flag=true' for booleans) removes that
    dependency entirely. Single-dash Nextflow core options (-profile, -c,
    -resume, ...) are passed through untouched.
    """
    out = []
    i = 0
    while i < len(extra):
        arg = extra[i]

        if not arg.startswith("--") or "=" in arg:
            out.append(arg)          # core option, or already name=value
            i += 1
            continue

        name = arg[2:]
        has_next = i + 1 < len(extra)
        next_is_value = has_next and not extra[i + 1].startswith("-")

        if name in VALUE_OPTS:
            if not has_next:
                print(f"{B_RED}ERROR:{CLR} '{arg}' requires a value (e.g. {arg} my_value).")
                sys.exit(1)
            if not next_is_value:
                print(
                    f"{B_RED}ERROR:{CLR} '{arg}' requires a value but was followed by "
                    f"'{extra[i + 1]}'."
                )
                print(
                    "Note: the first non-flag argument is taken as INPUT_DIR, so a "
                    "misplaced FASTQ directory can swallow this option's value."
                )
                sys.exit(1)
            out.append(f"{arg}={extra[i + 1]}")
            i += 2
        elif next_is_value:
            out.append(f"{arg}={extra[i + 1]}")   # unknown param with a value
            i += 2
        else:
            out.append(f"{arg}=true")             # boolean flag
            i += 1

    return out


def validate_input_dir(dir):
    """Fail fast with an actionable message when INPUT_DIR is wrong."""
    if not os.path.isdir(dir):
        print(f"{B_RED}ERROR:{CLR} INPUT_DIR '{dir}' is not an existing directory.")
        print("\nThe first non-flag argument must be the directory holding your FASTQ files:")
        print(f"  picorna-strm {B_BLUE}<FASTQ_DIR>{CLR} --local -profile docker --output <out_dir>")
        print(
            "\nIf you did pass a FASTQ directory, check that it comes before any "
            "option that takes a value -- otherwise it is read as that option's value."
        )
        sys.exit(1)


def make_fastq_map(dir):
    files = [
        f for f in os.listdir(dir) if f.endswith(".fastq") or f.endswith(".fastq.gz")
    ]

    if not files:
        print(f"{B_RED}ERROR:{CLR} no .fastq/.fastq.gz files found in '{dir}'.")
        print("Point INPUT_DIR at the directory that actually contains your FASTQ files.")
        sys.exit(1)

    paired_files = find_pairs(dir, files)
    return paired_files


def find_pairs(dir, files):
    pairs = defaultdict(list)
    for f in files:
        temp_delim = "." if "_" not in f else "_"
        pairs[f.split(temp_delim)[0]].append(os.path.join(dir, f))

    for pair in pairs.values():
        assert (
            len(pair) <= 2
        ), f"""
        more than 2 files per pair, file names are not unique enough: {pair};
        Ensure that filenames before the first '_' or '.' are unique to the sample.
        """
        pair.sort()
        if len(pair) == 1:
            pair.append("")

    return pairs


def confirm_samplesheet(fastq_map):
    print("\nsample\tfastq_1\tfastq_2")
    print("=======================================")
    for sample, row in fastq_map.items():
        r = [sample] + row
        print("\t".join(r))
    print("")

    while True:
        response = input("Does the samplesheet look correct? [y/n]").strip().lower()
        if response in ["yes", "y"]:
            return True
        elif response in ["no", "n"]:
            sys.exit(0)
        else:
            print("Please enter 'yes' or 'no'.")


def confirm_profile(profile_setting):
    if not profile_setting:
        r_text = "-profile is unset; this means that you'll run the pipeline locally, without using docker for dependencies. Is this what you want? [y/n]"
    elif profile_setting == "docker":
        r_text = "-profile is set to use docker; Is this what you want? [y/n]"
    else:
        r_text = "-profile is not set to anything recognizable: either set it to 'docker' or don't use it. Exiting..."
        exit(1)

    while True:
        response = input(r_text).strip().lower()
        if response in ["yes", "y"]:
            return True
        elif response in ["no", "n"]:
            sys.exit(0)
        else:
            print("Please enter 'yes' or 'no'")


def make_samplesheet(dir, samplesheet_name="samplesheet.csv", sep=","):
    fastq_map = make_fastq_map(dir)

    if sep == "," and not samplesheet_name.endswith(".csv"):
        samplesheet_name += ".csv"

    if sep == "\t" and not samplesheet_name.endswith(".tsv"):
        samplesheet_name += ".tsv"

    confirm_samplesheet(fastq_map)

    with open(samplesheet_name, "w") as outf:
        header = ["sample", "fastq_1", "fastq_2"]
        _ = outf.write(sep.join(header) + "\n")
        for sample, fastqs in fastq_map.items():
            _ = outf.write(f"{sample}{sep}{sep.join(fastqs)}\n")


def check_commit_history():
    output = subprocess.run(
        ["nextflow", "pull", "greninger-lab/revica-strm"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    if "contains uncommitted changes" in str(output.stdout):
        print(output.stdout.decode("utf-8"))
        print(f"{B_RED}This is a routine error. To correct this, please run:{CLR}")
        print("rm -r ~/.nextflow/assets/greninger-lab/revica-strm/")
        print("And confirm deletion of all files (this clears nextflow's cache).")
        sys.exit(0)
    else:
        print(f"{B_GREEN}Commit history clean. Proceeding...{CLR}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(add_help=False, exit_on_error=False)
    _ = parser.add_argument("input", help=argparse.SUPPRESS)
    _ = parser.add_argument(
        "-profile", required=False, default=None, help=argparse.SUPPRESS
    )
    _ = parser.add_argument("--print_log", action="store_true", help=argparse.SUPPRESS)
    _ = parser.add_argument(
        "--branch", default="main", choices=["main", "staging"], help=argparse.SUPPRESS
    )
    _ = parser.add_argument("-h", "--help", action="store_true", help=argparse.SUPPRESS)
    # This fork always runs from the local checkout (there is no public
    # nextflow-pullable repo for it); --local is kept for compatibility.
    _ = parser.add_argument("--local", action="store_true", default=True, help=argparse.SUPPRESS)

    try:
        args, extra = parser.parse_known_args()
    except argparse.ArgumentError as e:
        print(e)
        print(HELP)
        sys.exit(1)

    if args.help:
        print(HELP)
        sys.exit(0)

    profile = ["-profile", args.profile] if args.profile else []
    print_log = ["-process.echo"] if args.print_log else []

    extra = normalize_params(extra) + profile + print_log

    print_title("RUN SETUP", B_YELLOW)
    validate_input_dir(args.input)
    make_samplesheet(args.input)
    confirm_profile(args.profile)
    print_divider(B_YELLOW)

    print_title("RUN LOAD", B_BLUE)
    if args.local:
        # Resolve main.nf relative to THIS script, not to the current working
        # directory, so --local works from anywhere (e.g. from the FASTQ dir).
        # Nextflow takes the pipeline's own nextflow.config, bin/ and assets/
        # from the directory holding main.nf, so an absolute path is safe.
        exc_path = os.path.dirname(os.path.abspath(__file__))
        main_nf = os.path.join(exc_path, "main.nf")

        if not os.path.exists(main_nf):
            # fall back to the current directory for backwards compatibility
            if os.path.exists("main.nf"):
                main_nf = os.path.abspath("main.nf")
            else:
                print(
                    f"Cannot find main.nf next to this script ({exc_path}) "
                    "nor in the current directory (pipeline is not downloaded. Exiting...)"
                )
                exit(1)

        print(f"Running pipeline locally from {os.path.dirname(main_nf)} ...")
        run_cmd = ["nextflow", "run", main_nf, "--input", "samplesheet.csv"] + extra
    else:
        print(f"Running pipeline (most recent commit on branch {args.branch})")
        check_commit_history()
        run_cmd = [
            "nextflow",
            "run",
            "greninger-lab/revica-strm",
            "-r",
            args.branch,
            "-latest",
            "--input",
            "samplesheet.csv",
        ] + extra

    print_divider(B_BLUE)

    print_title("RUN BEGIN", B_GREEN)

    try:
        p = subprocess.Popen(run_cmd)
        p.wait()
    except KeyboardInterrupt:
        print("Abort signal recieved! Killing nextflow run...")
        p.send_signal(signal.SIGINT)
        p.send_signal(signal.SIGINT)  # sending twice since nextflow wants to confirm
        p.wait()
        sys.exit(1)

    print_divider(B_GREEN)
    sys.exit(0)
