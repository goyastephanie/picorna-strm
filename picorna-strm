# shutil.get_terminal_size() never raises: it falls back to the given size
# when there is no attached terminal (e.g. running under SLURM, cron, or a
# pipe). os.get_terminal_size() raises OSError ("Inappropriate ioctl for
# device") in those non-interactive contexts.
DIV_LEN = min(shutil.get_terminal_size(fallback=(100, 24)).columns, 100)


def print_divider(color):
    bar = "=" * DIV_LEN
    print(f"\n{color}{bar}{CLR}\n")


def print_title(title, color):
    n = DIV_LEN - (len(title) + 2)
    n, d = n // 2, n % 2
    l, r = n + d, n
    l_bar = "=" * l
    r_bar = "=" * r
    print(f"\n{color}{l_bar} {title} {r_bar}{CLR}")


def header(s):
    return f"{B_GREEN}{s}{CLR}"

