/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.

    NOTE: do NOT wrap these blocks in `if (params.x) { ... }`. Such conditions
    are evaluated while the config is parsed, when params.x still holds the
    value declared in nextflow.config -- values passed on the command line are
    applied later and would be ignored, silently dropping the whole block.
    Closures (`{ ... }`) are evaluated lazily at run time and DO see the final
    params, so use those instead. A withName selector for a process that never
    executes is harmless.
----------------------------------------------------------------------------------------
*/

process {

    // ---- read QC -----------------------------------------------------------
    withName: 'FASTQ_TRIM_FASTP_MULTIQC:FASTP' {
        // closure so that --fastp_container on the command line is honoured
        container = { params.fastp_container }
        ext.args = { "--cut_front --cut_tail --trim_poly_x --cut_mean_quality 20 --qualified_quality_phred 20 --unqualified_percent_limit 20 --length_required ${params.trim_len}" }
        publishDir = [
            [
                path: { "${params.output}/fastp/json" },
                mode: 'copy',
                // Only the JSON. The HTML is what MultiQC renders into one report,
                // and the plain-text .log carries the same numbers as the JSON in a
                // form nothing can parse. The JSON is the machine-readable QC record
                // (Q20/Q30, duplication, adapter content, per-cycle quality) and the
                // only way to regenerate or re-analyse QC once work/ is deleted.
                // Both files still exist in work/ and are still consumed there: the
                // JSON drives --min_trimmed_reads, the log feeds SUMMARY.
                pattern: "*.json"
            ],
            [
                path: { "${params.output}/fastp/fastq_trimmed" },
                mode: 'copy',
                pattern: "*.fastp.fastq.gz",
                enabled: { params.save_trimmed_reads }
            ],
            [
                path: { "${params.output}/fastp/trimmed_fail" },
                mode: 'copy',
                pattern: "*.fail.fastq.gz",
                enabled: { params.save_trimmed_fail }
            ],
        ]
    }

    withName: '.*:MULTIQC' {
        publishDir = [
            [
                path: { "${params.output}" },
                mode: 'copy',
                pattern: "*multiqc.html"
            ]
        ]
    }

    withName: SEQTK_SAMPLE {
        publishDir = [
            path: { "${params.output}/seqtk_sample" },
            mode: 'copy',
            pattern: "*.fastq.gz",
            enabled: { params.save_sample_reads }
        ]
    }

    withName: 'KRAKEN2' {
        ext.args = '--report-zero-counts'
        publishDir = [
            [
                path: { "${params.output}/kraken2" },
                mode: 'copy',
                pattern: "*.report.txt"
            ],
            [
                path: { "${params.output}/kraken2/classified_fastq" },
                mode: 'copy',
                pattern: "*classified*",
                enabled: { params.save_kraken2_classified_reads }
            ],
            [
                path: { "${params.output}/kraken2/unclassified_fastq" },
                mode: 'copy',
                pattern: "*unclassified*",
                enabled: { params.save_kraken2_unclassified_reads }
            ]
        ]
    }

    // ---- reference detection ------------------------------------------------
    withName: 'REFERENCE_PREP:BWA_MEM_ALIGN_DB' {
        publishDir = [
            // the coverage table is the evidence behind reference selection: always
            [
                path: { "${params.output}/align_to_db" },
                mode: 'copy',
                pattern: "*covstats.tsv"
            ],
            // the BAM of the reads against the whole database is never read by any
            // downstream step -- it exists only for manual inspection
            [
                path: { "${params.output}/align_to_db" },
                mode: 'copy',
                pattern: "*.bam",
                enabled: { params.save_db_bam }
            ]
        ]
    }

    withName: 'REFERENCE_PREP:SELECT_REFERENCE' {
        ext.args = { "-m ${params.ref_min_depth} -p ${params.ref_min_cov}" }
        publishDir = [
            [
                path: { "${params.output}/fail/align_to_db" },
                mode: 'copy',
                pattern: "*_failed_assembly.tsv"
            ]
        ]
    }

    withName: 'REFERENCE_PREP:MAKE_REFERENCE_FASTA' {
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}" }
        // the database reference extracted for this sample; published only
        // alongside the first-pass BAM it belongs to
        publishDir = [
            path: { "${params.output}/align_to_selected_ref" },
            mode: 'copy',
            pattern: "*.fa",
            enabled: { params.save_ref_bam }
        ]
    }

    // ---- consensus assembly, pass 1 -----------------------------------------
    withName: 'CONSENSUS_ASSEMBLY:BWA_MEM_ALIGN_QUERY' {
        ext.min_coverage = { "${params.ref_min_cov}" }
        ext.min_depth = { "${params.ref_min_depth}" }
        ext.iter = "ref"
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}_ref" }
        publishDir = [
            [
                path: { "${params.output}/align_to_selected_ref" },
                // 'copy', not 'link'. A hard link costs no disk and survives
                // deleting work/, but it needs work/ and --output on the same
                // filesystem, and when it cannot be made Nextflow logs a warning
                // and moves on -- the file is then silently absent from the
                // output. A predictable copy is worth the disk.
                mode: 'copy',
                pattern: "*.{bam,bai}",
                // closure, NOT a bare `params.x ? ... : ...` -- a ternary is
                // resolved when the config is parsed, before CLI params exist,
                // so the flag would silently never take effect
                enabled: { params.save_ref_bam && !(params.trim_primers || params.mode == 'amplicon') },
                // never publish the FAILED.sorted.bam placeholder: every failing
                // sample would write to the same filename and overwrite the others
                saveAs: { fn -> fn.startsWith('FAILED') ? null : fn }
            ],
            [
                path: { "${params.output}/fail/align_to_reference" },
                mode: 'copy',
                pattern: "*_failed_assembly.tsv"
            ]
        ]
    }

    withName: '.*:IVAR_CONSENSUS_BWA_MEM_ALIGN_INITIAL_ASSEMBLY:IVAR_CONSENSUS' {
        ext.args = { "-t ${params.ivar_init_t} -q ${params.ivar_init_q} -m ${params.ivar_init_m} -n N" }
        ext.args2 = { "--count-orphans --no-BAQ --max-depth ${params.mpileup_max_depth} --min-BQ 0 -aa" }
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}_consensus1" }
        // The first consensus is NOT a duplicate of the final one: it is the
        // reference of the second-pass BAM and of every VCF, so it is published
        // next to them.
        publishDir = [
            path: { "${params.output}/final_consensus_assemblies" },
            mode: 'copy',
            pattern: "*.fa"
        ]
    }

    // ---- consensus assembly, pass 2 -----------------------------------------
    withName: '.*:IVAR_CONSENSUS_BWA_MEM_ALIGN_INITIAL_ASSEMBLY:BWA_MEM_ALIGN' {
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}_consensus1" }
        ext.iter = "con1"
        ext.min_coverage = { "${params.cons_init_min_cov}" }
        ext.min_depth = { "${params.cons_init_min_depth}" }
        publishDir = [
            [
                path: { "${params.output}/final_consensus_assemblies" },
                mode: 'copy',
                pattern: "*.{bam,bai}",
                // In amplicon mode the consensus and the VCF are built from the
                // PRIMER-TRIMMED bam, published below. Publishing this one too
                // would put a BAM in that folder that is not the one the results
                // came from, so exactly one of the two is published.
                enabled: { !(params.trim_primers || params.mode == 'amplicon') },
                saveAs: { fn -> fn.startsWith('FAILED') ? null : fn }
            ],
            [
                path: { "${params.output}/fail/align_to_consensus" },
                mode: 'copy',
                pattern: "*_failed_assembly.tsv"
            ]
        ]
    }

    withName: 'CONSENSUS_ASSEMBLY:BUILD_FINAL_CONSENSUS' {
        ext.args = { "-t ${params.ivar_fin_t} -q ${params.ivar_fin_q} -m ${params.ivar_fin_m} -n N" }
        ext.args2 = { "--count-orphans --no-BAQ --max-depth ${params.mpileup_max_depth_final} --min-BQ 0 -aa" }
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}_consensus_final" }
        publishDir = [
            path: { "${params.output}/final_consensus_fasta" },
            mode: 'copy',
            pattern: "*.fa"
        ]
    }

    // ---- amplicon primer trimming (--mode amplicon) -------------------------
    withName: 'CONSENSUS_ASSEMBLY:PRIMER_BED_REF' {
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}_ref" }
        publishDir = [
            path: { "${params.output}/primer_trim" },
            mode: 'copy',
            pattern: "*_primers.bed"
        ]
    }

    withName: 'CONSENSUS_ASSEMBLY:PRIMER_BED_CON1' {
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}_consensus1" }
        publishDir = [
            path: { "${params.output}/primer_trim" },
            mode: 'copy',
            pattern: "*_primers.bed"
        ]
    }

    withName: 'CONSENSUS_ASSEMBLY:PRIMER_TRIM_REF' {
        ext.args = '-e'
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}_ref" }
        publishDir = [
            [
                path: { "${params.output}/align_to_selected_ref" },
                mode: 'copy',
                pattern: "*.primertrim.bam*",
                enabled: { params.save_ref_bam }
            ],
        ]
    }

    withName: 'CONSENSUS_ASSEMBLY:PRIMER_TRIM_CON1' {
        ext.args = '-e'
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}_consensus1" }
        publishDir = [
            [
                path: { "${params.output}/final_consensus_assemblies" },
                mode: 'copy',
                // this IS the alignment the final consensus and the VCF come
                // from in amplicon mode, so it is published by default
                pattern: "*.primertrim.bam*"
            ]
        ]
    }

    // ---- variant calling ----------------------------------------------------
    withName: BCFTOOLS_MPILEUP {
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}" }
        publishDir = [
            path: { "${params.output}/vcf" },
            mode: 'copy',
            pattern: "*.vcf"
        ]
    }

    withName: IVAR_VARIANTS {
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}" }
        publishDir = [
            path: { "${params.output}/variants" },
            mode: 'copy',
            pattern: "*.variants.tsv"
        ]
    }

    // ---- genotyping and reporting -------------------------------------------
    withName: VP1_TYPE {
        // word size 11 instead of megablast's 28. Measured on this VP1 database:
        // megablast loses the hit above ~13% divergence, while -task blastn still
        // finds it at 31% -- and --vp1_min_identity is 72, i.e. 28% divergence,
        // so with megablast that floor was unreachable and a divergent or
        // unrepresented genotype came back as no_hit instead of as its nearest
        // relative. Verified on all 184 database VP1s: identical calls, no new
        // ambiguous flags.
        ext.args = '-task blastn'
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}" }
        // no publishDir: every row is already in <run_name>_vp1_genotypes.tsv,
        // which main.nf builds with collectFile from these same files
    }

    withName: CHECK_CONTAMINATION {
        ext.prefix = { "${params.run_name}" }
        publishDir = [
            path: { "${params.output}" },
            mode: 'copy',
            pattern: "*_contamination.tsv"
        ]
    }

    withName: BAM_TO_FASTQ {
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}" }
        publishDir = [
            path: { "${params.output}/SRA" },
            mode: 'copy',
            pattern: "*_SRA.fastq.gz"
        ]
    }
    // NOTE: BAM_TO_FASTQ only runs at all when --save_sra_fastq is set (main.nf)

    withName: SUMMARY {
        ext.prefix = { "${meta.id}_${ref_info.acc}_${ref_info.tag}" }
    }
}
