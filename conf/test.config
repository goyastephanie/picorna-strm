// Small end-to-end test: one rhinovirus A51 amplicon sample, 20,000 single-end
// reads (tests/README.md). Run with:
//   nextflow run main.nf -profile test,docker
params {
	input = "${projectDir}/tests/samplesheet_test.csv"
	output = 'test_output'
	run_name = 'test'
	mode = 'amplicon'
	rhinovirus = true

	// fits a laptop
	max_cpus = 4
	max_memory = '8.GB'
	max_time = '1.h'
}
